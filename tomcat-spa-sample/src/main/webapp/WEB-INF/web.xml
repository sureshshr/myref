<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>tomcat-spa-sample</display-name>

  <servlet>
    <servlet-name>webInfSpaServlet</servlet-name>
    <servlet-class>com.example.spa.WebInfSpaServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>webInfSpaServlet</servlet-name>
    <url-pattern>/app/*</url-pattern>
  </servlet-mapping>

  <filter>
    <filter-name>spaFallbackFilter</filter-name>
    <filter-class>com.example.spa.SpaFallbackFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>spaFallbackFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>

</web-app>
